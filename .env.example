# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/eukexpress_db

# Resend API Keys
RESEND_API_KEY=re_your_resend_api_key_here
HERITAGE_RESEND_API_KEY=re_your_resend_api_key_here

# Email Configuration
HERITAGE_FROM_EMAIL=onboarding@support.heritagetrust.eukexpress.com
HERITAGE_FROM_NAME="Heritage Trust"

# Application Settings
APP_ENV=development
SECRET_KEY=your-secret-key-here
DEBUG=True

# Upload Paths
UPLOAD_PATH=./uploads
QR_CODE_PATH=./qr

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,https://yourdomain.com
